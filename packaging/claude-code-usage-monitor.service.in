[Unit]
Description=Claude Code Usage Monitor
Documentation=https://github.com/pieterhelsen/Claude-Code-Usage-Monitor-for-Linux
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.pieterhelsen.ClaudeCodeUsageMonitor
ExecStart=@BINDIR@/claude-code-usage-monitor --daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
